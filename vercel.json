{
  "version": 2,
  "framework": null,
  "buildCommand": "cd frontend && npm install --include=dev && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/crm", "destination": "/index.html" },
    { "source": "/m/:slug", "destination": "/index.html" }
  ]
}
